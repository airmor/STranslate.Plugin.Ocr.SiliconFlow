<UserControl
    x:Class="STranslate.Plugin.Ocr.SiliconFlow.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plugin="clr-namespace:STranslate.Plugin;assembly=STranslate.Plugin"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    mc:Ignorable="d"
    d:DesignHeight="700"
    d:DesignWidth="500">

    <ikw:SimpleStackPanel Spacing="12">

        <!--  API Key  -->
        <ui:SettingsCard Description="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_ApiKey_Description}" Header="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_ApiKey}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Key_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <PasswordBox
                MinWidth="280"
                plugin:PasswordBoxAssistant.Attach="True"
                plugin:PasswordBoxAssistant.Password="{Binding ApiKey}"
                ui:ControlHelper.PlaceholderText="sk-..." />
        </ui:SettingsCard>

        <!--  模型选择  -->
        <ui:SettingsCard Description="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_Model_Description}" Header="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_Model}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ScanText_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ComboBox
                MinWidth="280"
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding Models}"
                SelectedItem="{Binding SelectedModel, Mode=TwoWay}" />
        </ui:SettingsCard>

        <!--  PaddleOCR-VL 识别模式（仅 Paddle 选中时可见）  -->
        <ui:SettingsCard Description="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_PaddleMode_Description}" Header="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_PaddleMode}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Document_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ikw:SimpleStackPanel Orientation="Vertical" Spacing="8" Visibility="{Binding IsPaddleSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ComboBox
                    MinWidth="280"
                    ItemsSource="{Binding PaddleModes}"
                    SelectedItem="{Binding PaddleMode, Mode=TwoWay}" />
                <TextBlock
                    FontSize="{DynamicResource STControlFontSize12}"
                    Foreground="{DynamicResource {x:Static ui:ThemeKeys.SystemFillColorNeutralBrushKey}}"
                    Text="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_Spotting_Tip}"
                    Visibility="{Binding IsSpotting, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </ikw:SimpleStackPanel>
        </ui:SettingsCard>

        <!--  DeepSeek-OCR 官方模板（仅 DeepSeek 选中时可见）  -->
        <ui:SettingsCard Description="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_DeepSeekTemplate_Description}" Header="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_DeepSeekTemplate}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.DocumentBulletList_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ComboBox
                MinWidth="280"
                ItemsSource="{Binding DeepSeekTemplates}"
                SelectedItem="{Binding DeepSeekTemplate, Mode=TwoWay}"
                Visibility="{Binding IsDeepSeekSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </ui:SettingsCard>

        <!--  Qwen 自由提示词（仅 Qwen 选中时可见；唯一可编辑的提示词）  -->
        <ui:SettingsCard Description="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_QwenPrompt_Description}" Header="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_QwenPrompt}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Chat_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <TextBox
                MinWidth="280"
                MaxHeight="120"
                AcceptsReturn="True"
                Text="{Binding QwenPrompt, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
                Visibility="{Binding IsQwenSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </ui:SettingsCard>

        <!--  温度  -->
        <ui:SettingsCard Description="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_Temperature_Description}" Header="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_Temperature}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Temperature_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8">
                <Slider
                    x:Name="PART_TempSlider"
                    MinWidth="200"
                    IsSnapToTickEnabled="True"
                    Maximum="2.0"
                    Minimum="0.0"
                    TickFrequency="0.1"
                    TickPlacement="Both"
                    Value="{Binding Temperature}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding ElementName=PART_TempSlider, Path=Value, StringFormat=F1}" />
            </ikw:SimpleStackPanel>
        </ui:SettingsCard>

        <!--  最大 Tokens  -->
        <ui:SettingsCard Description="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_MaxTokens_Description}" Header="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_MaxTokens}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.TextBulletList_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <TextBox
                MinWidth="100"
                ui:ControlHelper.PlaceholderText="4096"
                Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}" />
        </ui:SettingsCard>

        <!--  超时（秒）  -->
        <ui:SettingsCard Description="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_Timeout_Description}" Header="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_Timeout}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Timer_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <TextBox
                MinWidth="100"
                ui:ControlHelper.PlaceholderText="30"
                Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
        </ui:SettingsCard>

        <!--  连接验证  -->
        <ui:SettingsCard Description="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_Validate_Description}" Header="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_Validate}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.CheckmarkCircle_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>
            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="12">
                <Button Command="{Binding ValidateCommand}" Style="{StaticResource AccentButtonStyle}">
                    <ui:IconAndText Content="{DynamicResource STranslate_Plugin_Ocr_SiliconFlow_Validate}" Icon="{x:Static ui:FluentSystemIcons.Play_24_Regular}" />
                </Button>
                <Border>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="Background" Value="{DynamicResource {x:Static ui:ThemeKeys.SystemFillColorAttentionBackgroundBrushKey}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ValidateResult}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource STControlFontSize12}"
                        Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                        Text="{Binding ValidateResult}" />
                </Border>
            </ikw:SimpleStackPanel>
        </ui:SettingsCard>

    </ikw:SimpleStackPanel>
</UserControl>
